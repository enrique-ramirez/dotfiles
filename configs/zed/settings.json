// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "new_window",
  "show_wrap_guides": true,
  "selection_highlight": true,
  "rounded_selection": true,
  "cursor_shape": "bar",
  "cursor_blink": true,
  "multi_cursor_modifier": "cmd_or_ctrl",
  "buffer_line_height": "comfortable",
  "buffer_font_weight": 400.0,
  "buffer_font_family": ".ZedMono",
  "icon_theme": "Zed (Default)",
  "agent_servers": {
    "claude-acp": {
      "default_config_options": {
        "mode": "bypassPermissions",
        "model": "default"
      },
      "favorite_config_option_values": {
        "model": [
          "default",
          "sonnet"
        ]
      },
      "type": "registry"
    }
  },
  // clangd from Homebrew's llvm rather than the copy Zed downloads, so the editor
  // and `clang-tidy` in a project's lint script are the same LLVM version.
  // Needs compile_commands.json to index a project: `bear -- <build command>`.
  "lsp": {
    "clangd": {
      "binary": {
        "path": "/opt/homebrew/opt/llvm/bin/clangd",
        "arguments": ["--background-index", "--header-insertion=never"]
      }
    }
  },
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "left"
  },
  "base_keymap": "VSCode",
  "ui_font_size": 14.0,
  "buffer_font_size": 12.0,
  "theme": {
    "mode": "system",
    "light": "Gruvbox Light",
    "dark": "Gruvbox Dark Hard",
  },
}
